{
  "name": "shopgen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP shopping server for mock.shop",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/http.ts",
    "dev": "tsx watch src/http.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "keywords": [
    "mcp",
    "shopify",
    "mock.shop"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.86.0"
  }
}
